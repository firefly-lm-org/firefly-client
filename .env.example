# 萤火虫大模型 Firefly LM — 客户端环境变量示例
# 复制此文件为 .env 并填入实际值

# 调度中心地址（默认 localhost:8000）
# FIREFLY_SCHEDULER_URL=http://localhost:8000

# 底座模型路径（HF 模型名或本地路径）
# 默认: unsloth/Qwen3-1.5B-Instruct-4bit
FIREFLY_MODEL_PATH=unsloth/Qwen3-1.5B-Instruct-4bit

# LoRA 超参（适配 3.9GB 显存）
FIREFLY_LORA_RANK=8
FIREFLY_LORA_ALPHA=16
FIREFLY_LORA_DROPOUT=0.05
FIREFLY_MAX_SEQ_LENGTH=512
FIREFLY_BATCH_SIZE=1
FIREFLY_GRAD_ACCUM=4
FIREFLY_LR=2e-4
FIREFLY_MAX_STEPS=60

# 训练数据路径（本地 JSONL/JSON 或 HF 数据集名）
# 默认: 内置 4 条 Demo
FIREFLY_DATA_PATH=data/alpaca_demo.jsonl

# 输出目录（默认 ~/.firefly/train_output）
# FIREFLY_OUTPUT_DIR=~/.firefly/train_output

# Checkpoint 目录（默认 ~/.firefly/checkpoints）
# FIREFLY_CHECKPOINT_DIR=~/.firefly/checkpoints
